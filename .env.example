# ==============================================================================
# TEEPHA FLOWERS & FABRICS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` and fill in your keys.
# Development defaults are provided so the application runs locally out of the box.

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION ENVIRONMENT (Consecutive incremented ports)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3331
API_PREFIX=api

API_PORT=3331
FRONTEND_PORT=3332
ADMIN_PORT=3333
MOBILE_PORT=3334

# URLs for CORS and redirects
FRONTEND_URL=http://localhost:3332
ADMIN_URL=http://localhost:3333
MOBILE_URL=http://localhost:3334
API_URL=http://localhost:3331

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Connect your PostgreSQL instance (Supabase, Railway, Neon, or local Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aether_commerce?schema=public"

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate strong 64-character random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=aether-commerce-jwt-access-secret-development-key-change-in-prod
JWT_REFRESH_SECRET=aether-commerce-jwt-refresh-secret-development-key-change-in-prod
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. GOOGLE AUTHENTICATION (Google Cloud Console / Identity Services)
# ------------------------------------------------------------------------------
# Setup:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized JavaScript origins:
#    - Development: http://localhost:3332, http://localhost:3333, http://localhost:3331
#    - Production:  https://teepha.com
# 4. Add Authorized redirect URIs:
#    - Development: http://localhost:3332/login, http://localhost:3331/api/auth/google/callback
#    - Production:  https://teepha.com/login, https://api.teepha.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3331/api/auth/google/callback

# ------------------------------------------------------------------------------
# 5. PAYSTACK PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Setup:
# 1. Sign up / Log in to your Paystack Dashboard: https://dashboard.paystack.co/#/settings/developer
# 2. For Development / Testing:
#    - Use your TEST keys (`sk_test_...` and `pk_test_...`).
#    - Note: If no keys are provided, the API automatically falls back to dev simulation mode.
# 3. For Production:
#    - Toggle to Live Mode on Paystack.
#    - Use your LIVE keys (`sk_live_...` and `pk_live_...`).
# 4. Webhook URL to register in Paystack Dashboard:
#    - Development (using ngrok/tunnel): https://your-tunnel.ngrok.io/api/payments/paystack/webhook
#    - Production: https://api.yourdomain.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_from_paystack_dashboard
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_from_paystack_dashboard

# Supported Payment Channels (comma-separated): card, bank_transfer, ussd, qr, bank
PAYSTACK_CHANNELS=card,bank_transfer,ussd,qr

# ------------------------------------------------------------------------------
# 6. REDIS CACHE & QUEUE (Optional - BullMQ Background Jobs)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 7. AI STYLE STUDIO GENERATION (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
STABILITY_API_KEY=
