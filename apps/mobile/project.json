{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/mobile/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/mobile",
        "browser": "apps/mobile/src/main.ts",
        "tsConfig": "apps/mobile/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mobile/public"
          }
        ],
        "styles": ["apps/mobile/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "mobile:build:production"
        },
        "development": {
          "buildTarget": "mobile:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/mobile/jest.config.cts",
        "tsConfig": "apps/mobile/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "mobile:build",
        "staticFilePath": "dist/apps/mobile/browser",
        "spa": true
      }
    },
    "capacitor-sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync android",
        "cwd": "{workspaceRoot}"
      }
    },
    "capacitor-open": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap open android",
        "cwd": "{workspaceRoot}"
      }
    },
    "capacitor-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run android",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-sync": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync android",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-open": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync android && npx cap open android",
        "cwd": "{workspaceRoot}"
      }
    },
    "android-run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync android && npx cap run android",
        "cwd": "{workspaceRoot}"
      }
    },
    "ios-sync": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync ios",
        "cwd": "{workspaceRoot}"
      }
    },
    "ios-open": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync ios && npx cap open ios",
        "cwd": "{workspaceRoot}"
      }
    },
    "ios-run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx cap sync ios && npx cap run ios",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
